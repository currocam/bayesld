# Matplotlib style for scientific plotting
# This is the base style for "SciencePlots"
# see: https://github.com/garrettj403/SciencePlots

# Set color cycle: blue, green, yellow, red, violet, gray
axes.prop_cycle: cycler(color=["008b92","f15c58","48cdef","bc56f0","8ddb17","f9cf9c","c90a4e","b0aaa2"])

# Set default figure size
figure.figsize : 6, 5
figure.dpi: 200.0
figure.constrained_layout.use: True
figure.facecolor:   white
figure.edgecolor:   None
figure.titleweight: bold
figure.titlesize:   x-large

# Set x axis
xtick.direction : out
xtick.major.size : 3
xtick.major.width : 0.5
xtick.minor.size : 1.5
xtick.minor.width : 0.5
xtick.minor.visible : False
xtick.top : False
xtick.bottom:       True
xtick.labelsize:    large
xtick.color:        .15

# Set y axis
ytick.direction : out
ytick.major.size : 3
ytick.major.width : 0.5
ytick.minor.size : 1.5
ytick.minor.width : 0.5
ytick.minor.visible : False
ytick.right : False
ytick.left:         True
ytick.labelsize:    large
ytick.color:        .15

# Set line widths
axes.linewidth : 0.8
grid.linewidth : 0.5
lines.linewidth : 1.
lines.solid_capstyle:   round

# Axes
axes.facecolor:         white
axes.edgecolor:         .33
axes.grid:              False
axes.grid.which:        major
axes.axisbelow:         True
axes.spines.right:      False
axes.spines.top:        False
axes.titlesize:         16
axes.titleweight:       bold
axes.labelsize:         large
axes.labelcolor:        .15
axes.labelweight:       normal

# Remove legend frame
legend.frameon : False
legend.framealpha:  0.5
legend.fancybox:    False
legend.numpoints: 1
legend.scatterpoints: 1
legend.fontsize: large

# Always save as 'tight'
savefig.bbox : tight
savefig.pad_inches : 0.05

# Use serif fonts
# font.serif : Times
font.family : serif
font.size:      12
font.style:     normal
font.variant:   normal
font.weight:    normal
font.stretch:   normal
mathtext.fontset : dejavuserif

# Use LaTeX for math formatting
text.usetex : True
text.latex.preamble : \usepackage{amsmath} \usepackage{amssymb}
text.color:     .15
image.cmap: viridis