params {
    figures_dir     = "${projectDir}/figures"
    lizards_dir     = "${projectDir}/analysis/psiculus"
    sbc_results_dir = "${projectDir}/results/sbc"
    sbc_n_batches   = 20

    benchmark_dir = "${projectDir}/analysis/benchmark"
    shadow_dir    = "/tmp/${System.getenv('USER')}"

    // Shared by every scenario: same genetic map, sample size, and rates
    benchmark_genome = [
        num_chroms:         4,
        chrom_length_bp:    100_000_000, // 1 Morgan at r = 1e-8
        recombination_rate: 1e-8,
        mutation_rate:      1e-8,
        num_individuals:    32,
        seed:               20250821,
    ]

    benchmark_scenarios = [
        [
            name: "decline",
            simulate_script: "simulate_decline.py",
            fit_scripts: ["fit_two_epoch.py", "fit_random_walk.py"],
        ],
    ]

    sbc_constant = [
        [
            name:              "constant_high",
            prior_ne:          5000,
            prior_sigma:       0.5,
            batch_size:        5,
            sample_size:       50,
            num_windows:       20,
            n_points_per_iter: 25,
            n_iter:            2,
        ],
    ]

    sbc_piecewise_constant = [
        [
            name:              "piecewise_constant_2epoch",
            prior_ne1:         5000,
            prior_ne2:         5000,
            prior_sigma_ne:    0.5,
            prior_t0:          50,
            prior_sigma_t0:    1.0,
            batch_size:        5,
            sample_size:       50,
            num_windows:       20,
            n_points_per_iter: 25,
            n_iter:            4,
        ],
        [
            name:              "piecewise_constant_2epoch_small",
            prior_ne1:         500,
            prior_ne2:         500,
            prior_sigma_ne:    0.5,
            prior_t0:          50,
            prior_sigma_t0:    0.5,
            batch_size:        5,
            sample_size:       50,
            num_windows:       20,
            n_points_per_iter: 25,
            n_iter:            4,
        ],
    ]
 sbc_piecewise_exponential = [
        [
            name:              "piecewise_exponential_small",
            prior_ne1:         500,
            prior_ne2:         500,
            prior_sigma_ne:    1.0,
            prior_t0:          50,
            prior_sigma_t0:    0.5,
            batch_size:        5,
            sample_size:       50,
            num_windows:       20,
            n_points_per_iter: 25,
            n_iter:            4,
        ],
        [
            name:              "piecewise_exponential_large",
            prior_ne1:         5000,
            prior_ne2:         5000,
            prior_sigma_ne:    1.0,
            prior_t0:          50,
            prior_sigma_t0:    0.5,
            batch_size:        5,
            sample_size:       50,
            num_windows:       20,
            n_points_per_iter: 25,
            n_iter:            4,
        ],
    ]
}

process {
    withLabel: 'simulation' {
        memory = '8 GB'
    }
    withLabel: 'inference' {
        memory = '16 GB'
    }
    withLabel: 'sampling' {
        cpus   = 1
        memory = '4 GB'
    }
    withLabel: 'plotting' {
        cpus   = 1
        memory = '4 GB'
    }
    withLabel: 'compilation' {
        cpus   = 4
        memory = '4 GB'
    }
    withLabel: 'gone_vcf' {
        cpus   = 1
        memory = '4 GB'
    }
    withLabel: 'gone' {
        cpus   = 8
        memory = '8 GB'
    }
    withLabel: 'hapne_prepare' {
        cpus   = 1
        maxForks = 8
        memory = '4 GB'
    }
    withLabel: 'plotting' {
        cpus = 4
        time = '60 min'
        module = ['calcua/all', 'uv/0.7.13-GCCcore-14.2.0']
    }
    withLabel: 'hapne_run' {
        cpus   = 8
        memory = '8 GB'
    }
    withLabel: 'phlash_run' {
        cpus   = 16
        memory = '16 GB'
    }
    withLabel: 'error_constant' {
        cpus   = 10
        memory = '8 GB'
    }
}

profiles {
    local {
        process.executor = 'local'
        process {
            withLabel: 'simulation' {
                cpus = 8
                module = ['calcua/all', 'BCFtools/1.22-GCC-14.2.0']
            }
            withLabel: 'inference' {
                cpus = 8
                memory = '16 GB'
            }
            withLabel: 'sampling' {
                cpus = 1
            }
            withLabel: 'gone_vcf' {
                module = ['calcua/all', 'BCFtools/1.22-GCC-14.2.0']
            }
            withLabel: 'gone' {
                module = ['calcua/all', 'foss/2026.1', 'BCFtools/1.22-GCC-14.2.0']
            }
            withLabel: 'hapne_prepare' {
                module = ['calcua/all', 'BCFtools/1.22-GCC-14.2.0']
                maxForks = 8
            }
            withLabel: 'hapne_run' {
                cpus = 8
                module = ['calcua/all', 'BCFtools/1.22-GCC-14.2.0', 'PLINK/2.00a3.7-gfbf-2023a', 'uv/0.7.13-GCCcore-14.2.0']
            }
            withLabel: 'phlash_run' {
                cpus = 16
                module = ['calcua/all', 'uv/0.7.13-GCCcore-14.2.0']
            }
        }
    }
    hpc {
        env {
            PATH           = "/scratch/antwerpen/210/vsc21003/RUSTUP/bin:\$PATH"
            UV_CACHE_DIR   = "/tmp/${System.getenv('USER')}/uv"
            CARGO_HOME     = "/tmp/vsc21003/RUST/"
            RUSTUP_HOME    = "/tmp/vsc21003/RUST"
            CMDSTAN        = "/data/antwerpen/210/vsc21003/bin/cmdstan/cmdstan-2.38.0"
        }
        process {
            withLabel: 'simulation' {
                cpus = 8
                module = ['calcua/all', 'uv/0.7.13-GCCcore-14.2.0', 'maturin/1.8.3-GCCcore-14.2.0', 'BCFtools/1.22-GCC-14.2.0']
                time = '360 min'
            }
            withLabel: 'inference' {
                cpus = 8
                time = '900 min'
                memory = '16 GB'
                module = ['calcua/all', 'uv/0.7.13-GCCcore-14.2.0', 'maturin/1.8.3-GCCcore-14.2.0']
            }
            withLabel: 'sampling' {
                cpus = 2
                time = '400 min'
                module = ['calcua/all', 'uv/0.7.13-GCCcore-14.2.0', 'maturin/1.8.3-GCCcore-14.2.0']
            }
            withLabel: 'compilation' {
                cpus = 4
                memory = '16 GB'
                module = ['calcua/all', 'foss/2026.1']
            }
            withLabel: 'gone_vcf' {
                cpus = 1
                time = '12 h'
                module = ['calcua/all', 'BCFtools/1.22-GCC-14.2.0']
            }
            withLabel: 'gone' {
                cpus = 8
                time = '12 h'
                module = ['calcua/all', 'foss/2026.1', 'BCFtools/1.22-GCC-14.2.0']
            }
            withLabel: 'hapne_prepare' {
                cpus = 1
                time = '12 h'
                module = ['calcua/all', 'BCFtools/1.22-GCC-14.2.0']
            }
            withLabel: 'hapne_run' {
                cpus = 8
                time = '12 h'
                module = ['calcua/all', 'BCFtools/1.22-GCC-14.2.0', 'PLINK/2.00a3.7-gfbf-2023a', 'uv/0.7.13-GCCcore-14.2.0']
            }
            withLabel: 'plotting' {
                cpus = 1
                executor = 'local'
                time = '10 min'
                module = ['calcua/all', 'uv/0.7.13-GCCcore-14.2.0']
            }
            withLabel: 'phlash_run' {
                cpus = 16
                time = '6 h'
                queue = 'pascal_gpu'
                clusterOptions = '--gres=gpu:1'
                module = ['calcua/all', 'uv/0.7.13-GCCcore-14.2.0']
            }
            withLabel: 'error_constant' {
                cpus = 10
                time = '2 h'
                module = ['calcua/all', 'uv/0.7.13-GCCcore-14.2.0', 'maturin/1.8.3-GCCcore-14.2.0']
            }
        }
        includeConfig 'vsc_calcua.config'
    }
}
