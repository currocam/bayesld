params {
    figures_dir     = "${projectDir}/figures"
    sbc_results_dir = "${projectDir}/results/sbc"
    sbc_n_batches   = 4

    sbc_constant = [
        [
            name:              "constant_high",
            prior_ne:          5000,
            prior_sigma:       0.5,
            batch_size:        50,
            sample_size:       50,
            num_windows:       50,
            n_points_per_iter: 3,
            n_iter:            10,
        ],
    ]

    sbc_piecewise_constant = [
        [
            name:              "piecewise_constant_2epoch",
            prior_ne1:         5000,
            prior_ne2:         5000,
            prior_sigma_ne:    0.5,
            prior_t0:          50,
            prior_sigma_t0:    1.0,
            batch_size:        50,
            sample_size:       50,
            num_windows:       50,
            n_points_per_iter: 6,
            n_iter:            10,
        ],
    ]
}

process {
    withLabel: 'simulation' {
        memory = '8 GB'
    }
    withLabel: 'inference' {
        memory = '8 GB'
    }
    withLabel: 'plotting' {
        cpus   = 1
        memory = '4 GB'
    }
}

profiles {
    local {
        process.executor = 'local'
        process {
            withLabel: 'simulation' {
                cpus = 8
            }
            withLabel: 'inference' {
                cpus = 8
            }
        }
    }
    hpc {
        env {
            PATH           = "/scratch/antwerpen/210/vsc21003/RUSTUP/bin:$PATH"
            UV_CACHE_DIR   = "/tmp/${System.getenv('USER')}/uv"
            CARGO_HOME     = "/tmp/vsc21003/RUST/"
            RUSTUP_HOME    = "/tmp/vsc21003/RUST"
            CMDSTAN        = "/data/antwerpen/210/vsc21003/bin/cmdstan/cmdstan-2.38.0"
        }
        process {
            withLabel: 'simulation' {
                cpus = 8
                module = ['calcua/all', 'uv/0.7.13-GCCcore-14.2.0', 'maturin/1.8.3-GCCcore-14.2.0']
            }
            withLabel: 'inference' {
                cpus = 8
                module = ['calcua/all', 'uv/0.7.13-GCCcore-14.2.0', 'maturin/1.8.3-GCCcore-14.2.0']
            }
        }
        includeConfig 'vsc_calcua.config'
    }
}
