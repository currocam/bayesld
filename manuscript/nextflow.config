params {
    figures_dir = "${projectDir}/figures"
}

process {
    withLabel: 'simulation' {
        memory = '8 GB'
    }
    withLabel: 'plotting' {
        cpus   = 1
        memory = '4 GB'
    }
}

profiles {
    local {
        process.executor = 'local'
        process {
            withLabel: 'simulation' {
                cpus = 8
            }
        }
    }
    hpc {
        env {
            PATH           = "${System.getenv('VSC_DATA')}/bin:\$PATH"
            UV_CACHE_DIR   = "/tmp/${System.getenv('USER')}/uv"
            CARGO_HOME     = "/tmp/${System.getenv('USER')}/.cargo"
            RUSTUP_HOME    = "/tmp/${System.getenv('USER')}/.rustup"
            CMDSTAN        = "${System.getenv('VSC_DATA')}/bin/cmdstan-2.36.0"
        }
        process {
            withLabel: 'simulation' {
                cpus = 8
                module = ['calcua/all', 'uv/0.7.13-GCCcore-14.2.0', 'maturin/1.8.3-GCCcore-14.2.0']
            }
        }
        includeConfig 'vsc_calcua.config'
    }
}
